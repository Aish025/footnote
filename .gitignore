# Secrets — tokens live in .env, never committed (hard rule 10)
.env
.env.*
!.env.example

# Corpus — never committed; rebuilt by scripts/download_data.py from data/manifest.yaml (hard rule 7)
data/raw/
data/processed/
# Run logs written next to the corpus (may quote review text)
data/*.log

