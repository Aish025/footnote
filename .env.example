# Copy to .env (gitignored) and fill in. Never commit .env.

# GitHub personal access token (fine-grained, public repositories read-only is enough).
# Needed by scripts/fetch_issues.py: GraphQL requires auth; limit is 5,000 points/hour.
GITHUB_TOKEN=

# Local Postgres (docker-compose.yml). Defaults are for local development only.
POSTGRES_USER=footnote
POSTGRES_PASSWORD=footnote
POSTGRES_DB=footnote
POSTGRES_PORT=5432
