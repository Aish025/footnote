# Normalise text to LF in the repo and working tree on every OS (Windows dev, Linux CI/Docker).
* text=auto eol=lf

# Files that code parses or containers execute: always LF.
*.py    text eol=lf
*.json  text eol=lf
*.jsonl text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.sql   text eol=lf
*.md    text eol=lf
*.sh    text eol=lf
.env.example text eol=lf

# Binary formats: never touch the bytes.
*.png   binary
*.jpg   binary
*.gz    binary
*.parquet binary
